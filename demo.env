# Dinner Scout (A4I 2026 mini-demo 1) — settings you might change.
#
# Everything reads this file when it starts (the probe, the server, the pre-show check). A variable you export in
# your shell wins over this file. Keys do NOT go here: they go in keys.env, which git ignores (see keys.env.example).
# `source scripts/activate.sh` prints what is in force.

# ---- Models ----------------------------------------------------------------------------------------------------
# The voice: the only agent that talks. Gemini API ID, checked 2026-10-09 on ai.google.dev (stable).
A4I_LIVE_MODEL=gemini-3.8-live
# The specialists (Scout and Vetter) are ordinary text agents.
A4I_TEXT_MODEL=gemini-3.8-flash
# Only the probe uses this: it speaks a line into the live session to test interruptions.
A4I_TTS_MODEL=gemini-3.8-flash-tts
# A prebuilt voice name. The language is automatic.
A4I_VOICE=Kore
# How hard the Scout and Navigator think: LOW, MEDIUM or HIGH (gemini-3.8-flash rejects MINIMAL). LOW made the
# Scout 3x faster in the dead-air probe (3.6 s against 10.4 s).
A4I_SPECIALIST_THINKING=LOW

# Where Gemini is served from.
#   vertex      (default) Vertex AI in your gcloud project, with no Gemini key: Cloud Shell's own credentials, a
#               service account on Cloud Run, or `gcloud auth application-default login` on a laptop.
#   gemini-api  a Gemini API key (GOOGLE_API_KEY in keys.env), the fallback if Vertex won't serve the Live model.
# The probe tries both and says which works.
A4I_BACKEND=vertex
# Vertex only. Where the Live model is served from. Verified 2026-10-09 in a lab project: "us" (the multi-region,
# aiplatform.us.rep.googleapis.com) and "us-central1" both answer; "global" says "not found". Live models are never
# served from global. `python probe/where_is_live.py` tries every location. Text models run at "global".
A4I_VERTEX_LOCATION=us
A4I_VERTEX_TEXT_LOCATION=global

# ---- Where "here" is -------------------------------------------------------------------------------------------
# The page starts where the browser says it is (it asks for the location when you press Start); on stage that is
# the venue. These landmarks are the FALLBACK when the browser can't or won't say, and where "I'm in Atlanta"
# lands if the browser is somewhere else. Text that Google Maps can find; venue addresses are better if we get them.
A4I_LANDMARK_TORONTO=Union Station, Toronto
A4I_LANDMARK_ATLANTA=Centennial Olympic Park, Atlanta
A4I_LANDMARK_SUNNYVALE=Murphy Avenue, Sunnyvale
A4I_LANDMARK_NEW_YORK=Chelsea Market, New York
# The fallback city when the browser gives no location.
A4I_DEFAULT_CITY=Toronto

# ---- The page's map ----------------------------------------------------------------------------------------
# A Map ID from Google Maps Platform > Map management (the pins need one). DEMO_MAP_ID is Google's ID for trying
# things out; make your own before the events if the map looks or behaves oddly.
A4I_MAPS_MAP_ID=DEMO_MAP_ID

# ---- Search -----------------------------------------------------------------------------------------------------
# How far around the landmark the Scout looks first, in metres (about a 15-minute walk).
A4I_SEARCH_RADIUS_M=1200
# Walking pace for the "about N minutes" figure (straight-line distance, so it is always labelled "about").
A4I_WALK_M_PER_MIN=80
# If they'd rather drive: how far the Scout looks (metres) and a city driving pace for "about N minutes' drive"
# (straight-line, so rough: 400 m/min is about 24 km/h through downtown traffic).
A4I_DRIVE_RADIUS_M=8000
A4I_DRIVE_M_PER_MIN=400
# Real walking and driving times from the Routes API (one call per search; the Places key, with the Routes API
# added by scripts/make_places_key.sh). "off" uses the straight-line estimates above. If a Routes call fails, the
# Scout falls back to the estimates on its own, so the demo never stalls.
A4I_ROUTES=on
# Driving times with current traffic (on) or typical, traffic-free times (off; billed at a lower tier).
A4I_ROUTES_TRAFFIC=on
