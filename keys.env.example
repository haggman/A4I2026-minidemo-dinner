# Copy this file to keys.env (git ignores keys.env) and fill in the values. Never commit keys.env.
#
#   cp keys.env.example keys.env
#
# A Gemini API key (Google AI Studio, aistudio.google.com > Get API key, created in your own Google Cloud project).
GOOGLE_API_KEY=
# A Google Maps Platform key, server side only, with "Places API (New)" enabled on the project and the key
# restricted to that API. Console: Google Maps Platform > Keys & Credentials.
MAPS_SERVER_KEY=
# A second Maps key for the page's map: "Maps JavaScript API" only, restricted by website (HTTP referrer) to
# http://localhost:8080/* and wherever the page is hosted. Not needed for the probe.
MAPS_BROWSER_KEY=
