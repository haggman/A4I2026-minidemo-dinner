# Copy this file to keys.env (git ignores keys.env) and fill in the values. Never commit keys.env.
# In Cloud Shell, `bash scripts/make_places_key.sh` makes keys.env and fills in MAPS_SERVER_KEY for you.
#
# A Google Maps Platform key, server side only, with "Places API (New)" enabled on the project and the key
# restricted to that API.
MAPS_SERVER_KEY=
# A second Maps key for the page's map: "Maps JavaScript API" only, restricted by website (HTTP referrer).
# Not needed for the probe.
MAPS_BROWSER_KEY=
# OPTIONAL. Gemini runs on Vertex AI with no key (A4I_BACKEND=vertex in demo.env). A Gemini API key from Google
# AI Studio is only the fallback if Vertex won't serve the Live model to your project.
GOOGLE_API_KEY=
